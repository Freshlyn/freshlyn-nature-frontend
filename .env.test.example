# Copy to .env.test.local (untracked) to enable the real-auth E2E specs.
# The auth spec reads OTP codes back from the otp_codes table using the
# service-role key (bypasses RLS). Without it, e2e/auth.spec.ts is skipped.

# Same project as .env.local:
VITE_SUPABASE_URL=https://qwtthzmojxxenrgznswl.supabase.co

# Service-role / secret key for the remote project (sb_secret_... form).
# Get it from the Supabase dashboard -> Project Settings -> API keys.
SUPABASE_SERVICE_ROLE_KEY=

# Must also appear in the TWOFACTOR_TEST_PHONES edge-function secret, in E.164
# form (+919123456789). The auth suite bypasses 2Factor for this number.
E2E_TEST_PHONE=9123456789
