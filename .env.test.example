# Copy to .env.test.local (untracked) to enable the real-auth E2E specs.
# The auth spec reads OTP codes back from the otp_codes table using the
# service-role key (bypasses RLS). Without it, e2e/auth.spec.ts is skipped.

# Same project as .env.local:
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role / secret key for the remote project (sb_secret_... form).
# Get it from the Supabase dashboard -> Project Settings -> API keys.
SUPABASE_SERVICE_ROLE_KEY=

# Pool of test numbers, one per spec that logs in, allocated by position
# against SPEC_PHONE_ORDER in e2e/helpers/otp.ts. Only ever APPEND: reordering
# reassigns numbers between specs. A spec past the end of this list skips
# itself, so add a number to switch it on.
#
# EVERY number here must ALSO be in the TWOFACTOR_TEST_PHONES edge-function
# secret, in E.164 form:
#
#   supabase secrets set \
#     TWOFACTOR_TEST_PHONES='+919123456789,+919123456780' \
#     --project-ref <your-project-ref>
#
# That match is an exact string comparison with no normalization. A number
# missing from the secret (or listed in the wrong format) takes the real
# 2Factor path: it stores no readable code, so the spec fails with "No OTP
# found", and it bills a real SMS to whoever owns the number.
E2E_TEST_PHONES=9123456789,9123456780,9123456790

# Single-number form, still read as a fallback when E2E_TEST_PHONES is unset.
# E2E_TEST_PHONE=9123456789
